default partial alphanumeric_keys

xkb_symbols "basic" {
    include "us(intl)"

    name[Group1] = "US International (aspas literais; trema e cedilha via AltGr)";

    // Level 1: dead acute; Level 2 (Shift): aspas literais;
    // Levels 3/4 (AltGr): dead diaeresis.
    key <AC11> {
        type[Group1] = "FOUR_LEVEL",
        [ dead_acute, quotedbl, dead_diaeresis, dead_diaeresis ]
    };

    // Level 1: c; Level 2 (Shift): C;
    // Levels 3/4 (AltGr): ccedilla / Ccedilla direta via hardware
    key <AB03> {
        type[Group1] = "FOUR_LEVEL",
        [ c, C, ccedilla, Ccedilla ]
    };

    // Faz AltGr (normalmente Alt direito) selecionar o nível 3.
    include "level3(ralt_switch)"
};
