[Icon Theme]
Name=SG-Icones
Comment=Tema flat minimalista exclusivo SG-Endeavour para KDE Plasma
Inherits=breeze,hicolor
Directories=scalable/apps,scalable/places

[scalable/apps]
Size=128
Type=Scalable
MinSize=16
MaxSize=512
Context=Applications

[scalable/places]
Size=128
Type=Scalable
MinSize=16
MaxSize=512
Context=Places
